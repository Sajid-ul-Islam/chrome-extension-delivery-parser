{
  "manifest_version": 3,
  "name": "DEEN Delivery Parser - Courier & Pathao Exporter",
  "version": "1.0.0",
  "description": "Extract, parse, and export Pathao and courier deliveries directly to Excel and CSV with 1-click and live KPI metrics.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "DEEN Delivery Parser"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "clipboardRead",
    "clipboardWrite",
    "contextMenus",
    "tabs",
    "notifications"
  ],
  "host_permissions": [
    "https://merchant.pathao.com/*",
    "https://*.pathao.com/*",
    "http://merchant.pathao.com/*",
    "http://*.pathao.com/*",
    "*://deencommerce.com/*",
    "*://*.deencommerce.com/*",
    "*://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://merchant.pathao.com/*",
        "https://*.pathao.com/*",
        "http://merchant.pathao.com/*",
        "http://*.pathao.com/*"
      ],
      "js": ["xlsx.mini.min.js", "parser.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://deencommerce.com/wp-admin/*",
        "*://*.deencommerce.com/wp-admin/*",
        "*://*/wp-admin/admin.php?page=wc-orders*",
        "*://*/wp-admin/post.php?post=*&action=edit*"
      ],
      "js": ["woocommerce.js"],
      "css": ["woocommerce.css"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "deen-delivery-parser@deencommerce.com",
      "strict_min_version": "109.0"
    }
  }
}
